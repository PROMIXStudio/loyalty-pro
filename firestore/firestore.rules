rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /admins/{adminId} {
      allow read, write: if request.auth != null && request.auth.uid == adminId;
    }
    match /boutiques/{boutiqueId} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null;
      match /clients/{clientId} {
        allow read, write: if request.auth != null;
        match /transactions/{txId} {
          allow read, write: if request.auth != null;
        }
      }
      match /gerants/{gerantId} {
        allow read, write: if request.auth != null;
      }
    }
    match /paiements/{id}      { allow read, write: if request.auth != null; }
    match /notifications/{id}  { allow read, write: if request.auth != null; }
    match /proprietaires/{id}  { allow read, write: if request.auth != null; }
  }
}